# ============================================================================
# Copy to `.env.local` (git-ignored) and fill in.
# VITE_* values are public browser configuration; server-only credentials below
# must never be prefixed with VITE_.
# ============================================================================

# ── OTP email delivery (SERVER ONLY) ─────────────────────────────────────────
# Set these in the Vercel project's Environment Variables, not in the browser.
GMAIL_USER=
GMAIL_APP_PASSWORD=

# ── Supabase browser client ─────────────────────────────────────────────────
# Supabase dashboard -> Project Settings -> API Keys / General.
# These are public-by-design values protected by RLS.
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=

# ── Signup OTP store (SERVER ONLY) ──────────────────────────────────────────
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Long random string used to HMAC the OTP.
OTP_PEPPER=

# GMAIL_USER / GMAIL_APP_PASSWORD above are used by /api/send-otp.

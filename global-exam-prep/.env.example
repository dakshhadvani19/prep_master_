# ============================================================================
#  Copy to `.env.local` (git-ignored) and fill in. Vite exposes VITE_* to the
#  browser, so these are NOT secrets — the secrets live only in the serverless
#  block below and must never be prefixed with VITE_.
# ============================================================================

# ── Firebase web config ─────────────────────────────────────────────────────
# Firebase console -> Project settings -> General -> Your apps ->
#   Web app -> SDK setup and configuration -> "Config"
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# ── OTP email delivery (used by api/send-otp.js) ────────────────────────────
# Set these in the Vercel project's Environment Variables, NOT in .env.local
# for production. Gmail requires an App Password
# (Google account -> Security -> 2-Step Verification -> App passwords).
GMAIL_USER=
GMAIL_APP_PASSWORD=

# ── Supabase — STUDENT AUTHENTICATION ONLY ──────────────────────────────────
# Supabase dashboard -> Project Settings -> API Keys (Publishable key) and
# Project Settings -> General -> Project URL.
#
# Both values are public BY DESIGN: row-level security on public.students is the
# enforcement layer, not the key. NEVER put the secret / service-role key
# (sb_secret_…) in a VITE_* variable — src/supabase.js refuses to boot with one.
# There is intentionally no VITE_SUPABASE_SECRET_KEY in this app.
#
# Set the real values in the Vercel project's Environment Variables too; Vite
# bakes them at build time, so a change requires a redeploy.
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=

# ── Signup OTP store (SERVER ONLY — api/_otpStore.js) ─────────────────────────
# Vercel project Environment Variables, never a VITE_* variable. The service-role
# key bypasses RLS by design, which is exactly why the browser must not have it:
# public.auth_otp is readable by no client role at all, and the only way in is
# these four functions (issue / verify / discard / prune).
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Long random string that keys the stored OTP digest (HMAC-SHA256). Rotating it
# invalidates every outstanding code, which is the intended response to a leak.
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
OTP_PEPPER=

# GMAIL_USER / GMAIL_APP_PASSWORD above are used again: /api/send-otp mints the
# code, stores only its digest in public.auth_otp, and mails it through Nodemailer.
# Supabase's own signup mailer stays OFF (Confirm email = OFF); see AUTH.md §9.

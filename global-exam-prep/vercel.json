{
    "buildCommand": "npm run build",
    "outputDirectory": "dist",
    "framework": "vite",
    "rewrites": [
        {
            "source": "/((?!api/).*)",
            "destination": "/index.html"
        }
    ],
    "functions": {
        "api/admin-subjects.js": {
            "includeFiles": "node_modules/{pdfjs-dist,@napi-rs}/**/*"
        }
    }
}

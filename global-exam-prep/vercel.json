{
    "buildCommand": "npm run build",
    "outputDirectory": "dist",
    "framework": "vite",
    "rewrites": [
        {
            "source": "/api/subscription-plans",
            "destination": "/api/dashboard-performance?razorpayAction=plans"
        },
        {
            "source": "/api/razorpay-create-order",
            "destination": "/api/dashboard-performance?razorpayAction=createOrder"
        },
        {
            "source": "/api/razorpay-verify-payment",
            "destination": "/api/dashboard-performance?razorpayAction=verifyPayment"
        },
        {
            "source": "/api/subscription-status",
            "destination": "/api/dashboard-performance?razorpayAction=status"
        },
        {
            "source": "/api/razorpay-webhook",
            "destination": "/api/admin-course-upload-worker?razorpayWebhook=1"
        },
        {
            "source": "/((?!api/).*)",
            "destination": "/index.html"
        }
    ],
    "functions": {
        "api/admin-subjects.js": {
            "includeFiles": "node_modules/{pdfjs-dist/legacy/build/*.mjs,pdfjs-dist/cmaps/**/*,pdfjs-dist/standard_fonts/**/*,pdfjs-dist/wasm/**/*,pdfjs-dist/iccs/**/*,pdfjs-dist/image_decoders/**/*,@napi-rs/canvas/**/*,@napi-rs/canvas-linux-x64-gnu/**/*}"
        }
    }
}

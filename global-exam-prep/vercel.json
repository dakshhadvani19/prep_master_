{
    "buildCommand": "npm run build",
    "outputDirectory": "dist",
    "framework": "vite",
    "rewrites": [
        {
            "source": "/((?!api/).*)",
            "destination": "/index.html"
        }
    ],
    "functions": {
        "api/admin-subjects.js": {
            "includeFiles": "node_modules/{pdfjs-dist/legacy/build/*.mjs,pdfjs-dist/cmaps/**/*,pdfjs-dist/standard_fonts/**/*,pdfjs-dist/wasm/**/*,pdfjs-dist/iccs/**/*,pdfjs-dist/image_decoders/**/*,@napi-rs/canvas/**/*,@napi-rs/canvas-linux-x64-gnu/**/*}"
        }
    }
}
